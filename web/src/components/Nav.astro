---
import Logo from './Logo.astro'
import { nav, site } from '../lib/site'
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 sm:px-6">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border-2 border-ink bg-paper/85 py-2 pr-2 pl-5 backdrop-blur-md" aria-label="Main">
    <a href="#top" class="text-xl" aria-label="Yapper home"><Logo /></a>
    <ul class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="rounded-full px-4 py-2 text-[0.95rem] font-medium transition-colors hover:bg-ink hover:text-paper">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={site.github} class="btn bg-ink !py-2.5 text-paper !shadow-none hover:!translate-0 hover:bg-ink-3" rel="noopener">
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
      <span>GitHub</span>
    </a>
  </nav>
</header>
