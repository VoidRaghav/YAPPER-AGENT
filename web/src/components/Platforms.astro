---
const platforms = [
  {
    name: 'WhatsApp',
    color: 'var(--color-wa)',
    tag: 'self-hosted',
    body: 'Runs on a spare number, or your own with a 🤖 label on every bot message. It is unofficial, so keep it to a few groups.',
    note: 'best for 2 to 5 friend groups',
    icon: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.6 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.4.6-.4.5c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3.1.2.1.9-.3 1.6Z',
  },
  {
    name: 'Telegram',
    color: 'var(--color-tg)',
    tag: 'official bot',
    body: 'Uses the official Bot API, so there is no group limit. Turn privacy mode off in BotFather so it can read the chat.',
    note: 'no cap on groups',
    icon: 'M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.7.8l-4.8-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.9 8.9-8c.4-.4-.1-.6-.6-.2L6.5 13.2 1.8 11.8c-1-.3-1-1 .2-1.5L20.5 3.2c.9-.3 1.6.2 1.4 1.1Z',
  },
  {
    name: 'Discord',
    color: 'var(--color-dc)',
    tag: 'official bot',
    body: 'An official bot that lives in the channels you choose. Switch on the Message Content intent in the developer portal.',
    note: 'up to 100 servers before verification',
    icon: 'M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.3 18.3 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.4A20.3 20.3 0 0 0 .2 18.1a19.9 19.9 0 0 0 6 3l1.3-2.1c-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.1 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.8 19.8 0 0 0 6-3 20.2 20.2 0 0 0-3.6-13.7ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z',
  },
]
---

<section id="platforms" class="mx-auto max-w-6xl scroll-mt-16 px-4 py-24 sm:px-6 lg:py-32" aria-labelledby="platforms-title">
  <div class="reveal mb-14">
    <p class="label mb-4 text-muted">platforms</p>
    <h2 id="platforms-title" class="display max-w-4xl text-[clamp(2.8rem,7vw,6rem)]">Lives where your <span class="serif font-normal">group already is.</span></h2>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    {
      platforms.map((p) => (
        <article class="reveal card group flex flex-col p-7 transition-transform duration-300 hover:-translate-y-1.5">
          <div class="flex items-center justify-between">
            <span class="grid size-14 place-items-center rounded-2xl border-2 border-ink text-white transition-transform duration-300 group-hover:-rotate-6" style={`background:${p.color}`}>
              <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true">
                <path d={p.icon} />
              </svg>
            </span>
            <span class="label rounded-full border-2 border-ink px-3 py-1 font-bold">{p.tag}</span>
          </div>
          <h3 class="display mt-8 text-4xl">{p.name}</h3>
          <p class="mt-3 text-ink/70">{p.body}</p>
          <p class="mt-auto flex items-center gap-2 pt-8 font-mono text-xs font-semibold">
            <span class="size-2 rounded-full" style={`background:${p.color}`} />
            {p.note}
          </p>
        </article>
      ))
    }
  </div>
</section>
